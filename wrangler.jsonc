{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "coffeeconnect",
  "routes": [
    {
      "pattern": "coffeeconnectcentre.com",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "coffeeconnect",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  "observability": {
    "enabled": true,
  },

  "vars": {
    "CONTACT_EMAIL": "info@coffeeconnectcentre.com",
  },
}
